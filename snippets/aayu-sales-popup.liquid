{% comment %}
  AyuPain Live Sales Notification Pop-up Toast
  - Alternating English & Hindi Verified Order Notifications
  - Clean Product Name: Pain Relief Oil
  - Non-intrusive bottom-left placement (positioned safely above sticky bars)
{% endcomment %}

<div id="aayu-sales-toast" class="aayu-sales-toast" aria-live="polite">
  <button type="button" class="aayu-sales-close" id="aayu-sales-close-btn" aria-label="Close">&times;</button>
  <div class="aayu-sales-content">
    <div class="aayu-sales-img-wrap">
      <img src="{{ 'ayupain-bottle-thumb.jpg' | asset_url }}" alt="AyuPain Relief Oil Bottle" width="50" height="50" loading="lazy">
    </div>
    <div class="aayu-sales-info">
      <div class="aayu-sales-header">
        <span class="aayu-sales-buyer" id="aayu-buyer-title">Ramesh (Jaipur)</span>
        <span class="aayu-sales-badge" id="aayu-badge-text">✓ Verified</span>
      </div>
      <p class="aayu-sales-detail" id="aayu-action-text">
        purchased <strong>Pain Relief Oil</strong>
      </p>
      <div class="aayu-sales-footer">
        <span class="aayu-sales-time" id="aayu-order-time">3 mins ago</span>
      </div>
    </div>
  </div>
</div>

<style>
  .aayu-sales-toast {
    position: fixed;
    bottom: 85px; /* Safely floats above mobile & desktop sticky COD / buy bars */
    left: 14px;
    z-index: 999990;
    width: 290px;
    max-width: calc(100vw - 28px);
    background: #ffffff;
    border-radius: 10px;
    padding: 9px 12px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12), 0 2px 5px rgba(0, 0, 0, 0.05);
    border: 1px solid #e5e7eb;
    border-left: 4px solid #0e5a36;
    display: flex;
    align-items: center;
    visibility: hidden;
    opacity: 0;
    transform: translateY(15px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .aayu-sales-toast.aayu-toast-visible {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .aayu-sales-close {
    position: absolute;
    top: 4px;
    right: 6px;
    background: none;
    border: none;
    font-size: 16px;
    line-height: 1;
    color: #9ca3af;
    cursor: pointer;
    padding: 2px 5px;
    border-radius: 50%;
  }

  .aayu-sales-close:hover {
    color: #111827;
    background: #f3f4f6;
  }

  .aayu-sales-content {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .aayu-sales-img-wrap {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #f4f8f5;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e5e7eb;
  }

  .aayu-sales-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aayu-sales-info {
    flex: 1;
    min-width: 0;
  }

  .aayu-sales-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    margin-bottom: 2px;
  }

  .aayu-sales-buyer {
    font-size: 12px;
    font-weight: 700;
    color: #0e5a36;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .aayu-sales-badge {
    font-size: 10px;
    font-weight: 600;
    color: #0e5a36;
    background: #e6f4ed;
    padding: 1px 5px;
    border-radius: 8px;
    white-space: nowrap;
  }

  .aayu-sales-detail {
    font-size: 12px;
    color: #374151;
    margin: 0 0 2px 0;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .aayu-sales-detail strong {
    color: #111827;
    font-weight: 700;
  }

  .aayu-sales-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 10px;
    color: #888888;
  }

  @media screen and (min-width: 750px) {
    .aayu-sales-toast {
      bottom: 24px;
      left: 24px;
      width: 300px;
    }
  }
</style>

<script>
  (function() {
    // Alternating English and Hindi Clean Purchase Notifications
    const salesData = [
      { title: "Ramesh (Jaipur)", action: "purchased <strong>Pain Relief Oil</strong>", badge: "✓ Verified", time: "3 mins ago" },
      { title: "सुनीता (लखनऊ)", action: "ने खरीदा <strong>Pain Relief Oil</strong>", badge: "✓ सत्यापित", time: "7 मिनट पहले" },
      { title: "Vikram (Bengaluru)", action: "purchased <strong>Pain Relief Oil</strong>", badge: "✓ Verified", time: "12 mins ago" },
      { title: "गुरप्रीत (लुधियाना)", action: "ने खरीदा <strong>Pain Relief Oil</strong>", badge: "✓ सत्यापित", time: "18 मिनट पहले" },
      { title: "Meenakshi (Chennai)", action: "purchased <strong>Pain Relief Oil</strong>", badge: "✓ Verified", time: "25 mins ago" },
      { title: "राजेश (इंदौर)", action: "ने खरीदा <strong>Pain Relief Oil</strong>", badge: "✓ सत्यापित", time: "32 मिनट पहले" },
      { title: "Anita (Pune)", action: "purchased <strong>Pain Relief Oil</strong>", badge: "✓ Verified", time: "40 mins ago" },
      { title: "सुरेश (अहमदाबाद)", action: "ने खरीदा <strong>Pain Relief Oil</strong>", badge: "✓ सत्यापित", time: "48 मिनट पहले" },
      { title: "Amitabh (Kolkata)", action: "purchased <strong>Pain Relief Oil</strong>", badge: "✓ Verified", time: "55 mins ago" },
      { title: "दीपक (गुरुग्राम)", action: "ने खरीदा <strong>Pain Relief Oil</strong>", badge: "✓ सत्यापित", time: "1 घंटा पहले" },
      { title: "Priya (Kochi)", action: "purchased <strong>Pain Relief Oil</strong>", badge: "✓ Verified", time: "1 hour ago" },
      { title: "महेश (पटना)", action: "ने खरीदा <strong>Pain Relief Oil</strong>", badge: "✓ सत्यापित", time: "1 घंटा पहले" }
    ];

    let currentIndex = 0;
    let toastTimeout = null;
    let cycleInterval = null;
    let isDismissed = false;

    if (sessionStorage.getItem('aayu_sales_toast_dismissed') === 'true') {
      return;
    }

    const toastEl = document.getElementById('aayu-sales-toast');
    const closeBtn = document.getElementById('aayu-sales-close-btn');
    const buyerTitleEl = document.getElementById('aayu-buyer-title');
    const badgeTextEl = document.getElementById('aayu-badge-text');
    const actionTextEl = document.getElementById('aayu-action-text');
    const orderTimeEl = document.getElementById('aayu-order-time');

    if (!toastEl) return;

    function showNotification() {
      if (isDismissed) return;

      const currentItem = salesData[currentIndex];
      buyerTitleEl.textContent = currentItem.title;
      badgeTextEl.textContent = currentItem.badge;
      actionTextEl.innerHTML = currentItem.action;
      orderTimeEl.textContent = currentItem.time;

      toastEl.classList.add('aayu-toast-visible');

      toastTimeout = setTimeout(() => {
        toastEl.classList.remove('aayu-toast-visible');
        currentIndex = (currentIndex + 1) % salesData.length;
      }, 4500);
    }

    closeBtn.addEventListener('click', function() {
      isDismissed = true;
      toastEl.classList.remove('aayu-toast-visible');
      if (toastTimeout) clearTimeout(toastTimeout);
      if (cycleInterval) clearInterval(cycleInterval);
      sessionStorage.setItem('aayu_sales_toast_dismissed', 'true');
    });

    setTimeout(() => {
      showNotification();
      cycleInterval = setInterval(showNotification, 10500);
    }, 3000);
  })();
</script>
